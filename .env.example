# Google Gemini API Key for LangGraph nodes
GOOGLE_API_KEY=your-gemini-api-key-here

# Groq API Key (optional — enables Groq models)
GROQ_API_KEY=your-groq-api-key-here

# OpenRouter API Key (optional — enables OpenRouter models, get at https://openrouter.ai/keys)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# MOCK MODE (set to True to bypass real SSH connection if you don't have GNS3 running yet)
MOCK_SSH=False

# Default SSH Credentials (If your GNS3 switch uses different creds, change them here)
DEFAULT_SSH_USERNAME=admin
DEFAULT_SSH_PASSWORD=cisco
DEFAULT_SSH_SECRET=cisco # for enable mode if needed
